# ── Database ──────────────────────────────────────────────────────────────────
# Used ONLY by legacy tooling. Prefer `npm run db:push` via Supabase CLI.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used by CI for `supabase db push`
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_DB_PASSWORD=your-database-password

# ── Clerk Authentication ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
CLERK_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── OpenAI (AI Companion / Sanctuary chat) ────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key

# ── Stripe (Web billing) ──────────────────────────────────────────────────────
# See: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ── Mobile (Expo) ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ── Vercel (CI/CD) ────────────────────────────────────────────────────────────
# Add these as GitHub Actions secrets, not in this file:
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID

# ── Expo EAS (CI/CD) ──────────────────────────────────────────────────────────
# Add as a GitHub Actions secret:
# EXPO_TOKEN
